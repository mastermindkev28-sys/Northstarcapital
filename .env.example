# NORTHSTAR CAPITAL™ — environment variable template
# Copy to .env and fill in. NEVER commit .env.
# Empty values only in this file — no real secrets, ever.

# --- runtime ---------------------------------------------------------------
NORTHSTAR_ENV=local              # local | staging | production
NORTHSTAR_MODE=shadow            # shadow | backtest   (live is not implemented)
NORTHSTAR_CONFIG=config/northstar.defaults.yaml
NORTHSTAR_PROFILE=
LOG_LEVEL=INFO

# --- database --------------------------------------------------------------
DATABASE_URL=

# --- TradingView webhook ---------------------------------------------------
WEBHOOK_SECRET=
TRADINGVIEW_IP_ALLOWLIST=        # comma-separated; verify against TradingView docs at deploy

# --- Telegram --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OPS_CHAT_ID=

# --- object store (screenshots) --------------------------------------------
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_BUCKET=
OBJECT_STORE_KEY=
OBJECT_STORE_SECRET=

# --- market data -----------------------------------------------------------
DATA_VENDOR=
DATA_API_KEY=

# --- news ------------------------------------------------------------------
NEWS_API_KEY=

# --- execution (NOT IMPLEMENTED — leave empty) ------------------------------
# No broker credentials belong in this system at this stage.
